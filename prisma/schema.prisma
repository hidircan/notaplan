generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// Top-level multi-tenant boundary
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  users     User[]
  schools   School[]
  branches  Branch[]
  teachers  Teacher[]
  students  Student[]
  rooms     Room[]
  lessons   Lesson[]
  attendances Attendance[]
  makeupRequests MakeupRequest[]
  payments  Payment[]
  followUpCases PaymentFollowUpCase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Auth identity — passwordHash is Argon2/bcrypt; never store plaintext
model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  role         String
  teacherId    String?
  studentId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

model School {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  shortName             String
  city                  String
  website               String
  email                 String
  phone                 String
  logoUrl               String
  makeupWindowDays      Int
  lessonDurationMinutes Int
  workingHoursStart     String
  workingHoursEnd       String
  workingDays           Json
  currency              String
  branches              Branch[]
  teachers              Teacher[]
  students              Student[]
  rooms                 Room[]
  lessons               Lesson[]
  attendances           Attendance[]
  makeupRequests        MakeupRequest[]
  payments              Payment[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId])
  @@index([tenantId])
}

model Branch {
  id             String    @id
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId       String
  name           String
  shortName      String
  address        String
  phone          String
  city           String
  teachers       Teacher[]
  students       Student[]
  rooms          Room[]
  lessons        Lesson[]
  makeupRequests MakeupRequest[]

  @@index([tenantId])
  @@index([schoolId])
}

model Teacher {
  id              String   @id
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String
  branch          Branch   @relation(fields: [branchId], references: [id])
  branchId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  instruments     Json
  availability    Json
  maxDailyLessons Int
  active          Boolean
  color           String
  students        Student[]
  lessons         Lesson[]
  makeupRequests  MakeupRequest[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([schoolId])
}

model Student {
  id                String    @id
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String
  parentName        String
  parentPhone       String
  branch            Branch    @relation(fields: [branchId], references: [id])
  branchId          String
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId          String
  instruments       Json
  teacher           Teacher   @relation(fields: [teacherId], references: [id])
  teacherId         String
  packageName       String
  weeklyLessonCount Int
  monthlyFee        Int
  active            Boolean
  notes             String
  createdAt         DateTime  @default(now())
  lessons           Lesson[]
  attendances       Attendance[]
  payments          Payment[]
  makeupRequests    MakeupRequest[]

  @@index([tenantId])
  @@index([schoolId])
}

model Room {
  id          String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String
  capacity    Int
  instruments Json
  lessons     Lesson[]

  @@index([tenantId])
}

model Lesson {
  id              String       @id
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id])
  studentId       String
  teacher         Teacher      @relation(fields: [teacherId], references: [id])
  teacherId       String
  room            Room         @relation(fields: [roomId], references: [id])
  roomId          String
  branch          Branch       @relation(fields: [branchId], references: [id])
  branchId        String
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId        String
  instrument      String
  startAt         DateTime
  endAt           DateTime
  type            String
  status          String
  makeupRequestId String?
  notes           String?
  attendances     Attendance[]

  @@index([tenantId])
  @@index([schoolId])
}

model Attendance {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lesson              Lesson         @relation(fields: [lessonId], references: [id])
  lessonId            String         @unique
  student             Student        @relation(fields: [studentId], references: [id])
  studentId           String
  status              String
  reason              String?
  markedAt            DateTime
  createsMakeupCredit Boolean
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId            String
  makeupRequest       MakeupRequest?

  @@index([tenantId])
}

model MakeupRequest {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student    @relation(fields: [studentId], references: [id])
  studentId         String
  teacher           Teacher    @relation(fields: [teacherId], references: [id])
  teacherId         String
  branch            Branch     @relation(fields: [branchId], references: [id])
  branchId          String
  school            School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId          String
  instrument        String
  sourceLessonId    String
  attendance        Attendance @relation(fields: [attendanceId], references: [id])
  attendanceId      String     @unique
  status            String
  reason            String
  expiresAt         DateTime
  suggestedSlots    Json
  confirmedLessonId String?
  createdAt         DateTime
  policyNote        String

  @@index([tenantId])
  @@index([sourceLessonId])
}

model Payment {
  id          String    @id
  tenantId    String
  followUps   PaymentFollowUpCase[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id])
  studentId   String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId    String
  amount      Int
  paidAmount  Int
  status      String
  dueDate     DateTime
  paidAt      DateTime?
  description String
  method      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

model PaymentFollowUpCase {
  id            String    @id
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentId     String
  status        String    @default("draft")
  messageDraft  String
  approvedBy    String?
  approvedAt    DateTime?
  sentAt        DateTime?
  resolvedAt    DateTime?
  attributedAmount Int    @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([paymentId])
}

/// Recurring autonomous workflow state — per-workflow singleton
model WorkflowState {
  id          String    @id
  enabled     Boolean
  lastRunAt   DateTime?
  lastSuccess Boolean?
  lastError   String?
  runCount    Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

/// One execution of an autonomous workflow (history)
model WorkflowRun {
  id         String    @id
  workflowId String
  tenantId   String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  success    Boolean
  steps      Json
  error      String?

  @@index([workflowId, tenantId, startedAt])
}
